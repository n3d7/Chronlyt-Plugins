        },
        "publisher": {
          "type": "string",
          "x-chronlyt-max-utf8-bytes": 120,
          "x-chronlyt-min-utf8-bytes": 1
        },
        "repository_url": {
          "type": "string"
        },
        "stars": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "summary": {
          "type": "string",
          "x-chronlyt-max-utf8-bytes": 300,
          "x-chronlyt-min-utf8-bytes": 1
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "type": "array"
        },
        "updated_at": {
          "type": "string"
        },
        "verified": {
          "type": "boolean"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "summary",
        "description",
        "author",
        "publisher",
        "repository_url",
        "license",
        "categories",
        "tags",
        "created_at",
        "updated_at",
        "version",
        "chronlyt_compatibility",
        "api_version",
        "artifact",
        "permissions",
        "changelog",
        "verified",
        "official"
