      "type": "object"
    },
    "PluginId": {
      "type": "string",
      "x-chronlyt-max-utf8-bytes": 57,
      "x-chronlyt-min-utf8-bytes": 1
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "generated_at": {
      "type": "string"
    },
    "plugins": {
      "items": {
        "$ref": "#/$defs/PluginCatalogEntryV1"
      },
      "maxItems": 1000,
      "type": "array"
    },
    "schema_version": {
      "const": 1,
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "generated_at",
    "plugins"
  ],
  "title": "PluginCatalogV1",
  "type": "object",
  "x-chronlyt-max-utf8-bytes": 2097152,
  "x-chronlyt-semantic-validation-required": true
