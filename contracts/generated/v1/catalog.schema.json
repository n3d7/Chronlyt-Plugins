{
  "$defs": {
    "Capability": {
      "enum": [
        "storage.read",
        "storage.write",
        "timeline.read",
        "timeline.write",
        "notifications.show"
      ],
      "type": "string"
    },
    "CatalogArtifactV1": {
      "additionalProperties": false,
      "properties": {
        "sha256": {
          "type": "string"
        },
        "size": {
          "format": "uint64",
          "maximum": 16777216,
          "minimum": 1,
          "type": "integer"
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "url",
        "sha256",
        "size"
      ],
      "type": "object"
    },
    "PluginCatalogEntryV1": {
      "additionalProperties": false,
      "properties": {
        "api_version": {
          "const": 1,
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": "integer"
        },
        "artifact": {
          "$ref": "#/$defs/CatalogArtifactV1"
        },
        "author": {
          "type": "string",
          "x-chronlyt-max-utf8-bytes": 120,
          "x-chronlyt-min-utf8-bytes": 1
        },
        "categories": {
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "type": "array"
        },
        "changelog": {
          "type": "string",
          "x-chronlyt-max-utf8-bytes": 8000
        },
        "chronlyt_compatibility": {
          "type": "string"
        },
        "created_at": {
          "type": "string"
        },
        "description": {
          "type": "string",
          "x-chronlyt-max-utf8-bytes": 4000
        },
        "downloads": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "id": {
          "$ref": "#/$defs/PluginId"
        },
        "license": {
          "type": "string",
          "x-chronlyt-max-utf8-bytes": 80,
          "x-chronlyt-min-utf8-bytes": 1
        },
        "name": {
          "type": "string",
          "x-chronlyt-max-utf8-bytes": 80,
          "x-chronlyt-min-utf8-bytes": 1
        },
        "official": {
          "type": "boolean"
        },
        "permissions": {
          "items": {
            "$ref": "#/$defs/Capability"
          },
          "maxItems": 32,
          "type": "array",
